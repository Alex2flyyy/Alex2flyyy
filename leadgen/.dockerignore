# Keep the build context small and keep secrets out of the image.
.git
.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
.coverage
dist
build
*.egg-info

# Never copy real credentials or collected data into an image.
.env
.env.*
!.env.example
credentials*.json
service-account*.json
data/

# Docs are not needed at runtime; README.md is kept because pyproject
# references it as the long description and the build would fail without it.
docs/
tests/
