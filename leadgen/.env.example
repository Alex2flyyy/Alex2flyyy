# =============================================================================
# leadgen — environment configuration
# Copy to .env and fill in.  NEVER commit .env.
# =============================================================================

# --- Core -------------------------------------------------------------------
LEADGEN_ENV=development                 # development | staging | production
LEADGEN_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LEADGEN_LOG_FORMAT=console              # console | json   (use json in prod)
LEADGEN_TIMEZONE=America/Los_Angeles

# --- Database ---------------------------------------------------------------
# asyncpg driver for the app, psycopg for Alembic (set automatically if unset)
LEADGEN_DATABASE_URL=postgresql+asyncpg://leadgen:leadgen@localhost:5432/leadgen
LEADGEN_DB_POOL_SIZE=10
LEADGEN_DB_MAX_OVERFLOW=20

# --- Discovery providers ----------------------------------------------------
# Google Places API (New).  Primary source.  Enable "Places API (New)" +
# "Geocoding API" in Google Cloud console and restrict the key by API.
LEADGEN_GOOGLE_MAPS_API_KEY=
# PageSpeed Insights shares the Google key by default; override if you use a
# separate quota project.
LEADGEN_PAGESPEED_API_KEY=

# Optional secondary providers (leave blank to disable)
LEADGEN_SERPAPI_KEY=
LEADGEN_BING_MAPS_KEY=
LEADGEN_FOURSQUARE_API_KEY=

# Comma-separated, in priority order. Options: google_places, osm, serpapi
LEADGEN_DISCOVERY_PROVIDERS=google_places,osm

# --- AI ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
LEADGEN_AI_MODEL=claude-sonnet-5
LEADGEN_AI_MODEL_PREMIUM=claude-opus-5
LEADGEN_AI_ENABLED=true
LEADGEN_AI_MAX_CONCURRENCY=4
LEADGEN_AI_DAILY_TOKEN_BUDGET=2000000

# --- Pipeline targets -------------------------------------------------------
LEADGEN_DAILY_LEAD_TARGET=50            # qualified leads wanted per run
LEADGEN_DAILY_DISCOVERY_CAP=2000        # hard ceiling on businesses fetched/run
LEADGEN_MAX_CONCURRENT_AUDITS=8
LEADGEN_AUDIT_TIMEOUT_SECONDS=45
LEADGEN_ENABLE_BROWSER_AUDIT=true       # false = HTTP-only audits (much faster)
LEADGEN_ENABLE_SCREENSHOTS=true
LEADGEN_SCREENSHOT_DIR=./data/screenshots

# --- Politeness / compliance ------------------------------------------------
LEADGEN_USER_AGENT=leadgen-prospect-bot/1.0 (+https://example.com/bot)
LEADGEN_RESPECT_ROBOTS_TXT=true
LEADGEN_PER_HOST_RPS=0.5                # requests/second against any one host
LEADGEN_GLOBAL_RPS=12
LEADGEN_CRAWL_MAX_PAGES_PER_SITE=5

# --- API / dashboard --------------------------------------------------------
LEADGEN_API_HOST=0.0.0.0
LEADGEN_API_PORT=8000
LEADGEN_API_KEY=                        # required for write endpoints in prod
LEADGEN_DASHBOARD_ENABLED=true
LEADGEN_CORS_ORIGINS=http://localhost:3000

# --- Exports ----------------------------------------------------------------
LEADGEN_EXPORT_DIR=./data/exports

# Google Sheets: path to a service-account JSON key; share the sheet with the
# service account's email address.
LEADGEN_GOOGLE_SHEETS_CREDENTIALS_FILE=
LEADGEN_GOOGLE_SHEETS_SPREADSHEET_ID=

# Notion
LEADGEN_NOTION_API_KEY=
LEADGEN_NOTION_DATABASE_ID=

# Airtable
LEADGEN_AIRTABLE_API_KEY=
LEADGEN_AIRTABLE_BASE_ID=
LEADGEN_AIRTABLE_TABLE_NAME=Leads

# --- Notifications (optional) ----------------------------------------------
LEADGEN_SLACK_WEBHOOK_URL=
LEADGEN_REPORT_EMAIL_TO=
