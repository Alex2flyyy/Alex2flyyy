# =============================================================================
# PawParty environment
# =============================================================================
# Copy to `.env` and fill in only what you actually use.
#   cp .env.example .env
#
# NOTHING here is required for the offline demo. With no keys at all the
# pipeline runs end to end using the `synth` providers, which build real
# playable MP4s with ffmpeg. Keys are what upgrade `synth` -> real AI footage.
# -----------------------------------------------------------------------------

# --- Video generation ---------------------------------------------------------
# Replicate (video + image). https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# fal.ai (video + image). https://fal.ai/dashboard/keys
FAL_KEY=

# --- Copywriting (hooks / captions / hashtag expansion) -----------------------
# Anthropic. https://console.anthropic.com/settings/keys
# Optional: without it, the deterministic offline copywriter is used.
ANTHROPIC_API_KEY=

# --- Publishing ---------------------------------------------------------------
# TikTok Content Posting API. Requires an approved developer app; see
# docs/PUBLISHING.md. Without these, PawParty exports a ready-to-post folder
# and you upload manually.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- Operational --------------------------------------------------------------
# Hard ceiling on provider spend per calendar day, in USD. The pipeline aborts
# remaining jobs once the ledger crosses this. 0 disables paid providers.
PAWPARTY_DAILY_BUDGET_USD=6.00

# Workspace root override (default: ./Videos next to the config file).
PAWPARTY_WORKSPACE=
